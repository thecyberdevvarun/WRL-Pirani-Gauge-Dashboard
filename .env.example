# Copy this file to .env and fill in your real values. .env is git-ignored.

# =============================================================================
# SQL SERVER (used by db.py)
# =============================================================================
DB_SERVER=your-sql-server-ip
DB_NAME=your-database
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# =============================================================================
# LOGIN SESSIONS
# =============================================================================
# Long random string used to sign login cookies. Keep it secret and keep it
# the same between restarts (if it changes, everyone has to log in again).
SECRET_KEY=change-me-to-a-long-random-string
# How long a login lasts, in hours.
SESSION_HOURS=12

# Set to 1 to disable the background Modbus/fixture polling threads
# (useful for running tests or a quick syntax check without hardware).
DISABLE_WORKERS=0

# =============================================================================
# POLLING  (which gauges THIS PC talks to)
# =============================================================================
# line_specific : this PC polls only the lines named in POLL_LINES. Use this
#                 when each production line has its own PC on its own subnet.
#                 Put the SAME .env on every PC and change only POLL_LINES.
# centralized   : this PC polls every line. Only use it when this PC has a
#                 verified network route to every line's subnet.
POLLING_MODE=line_specific
# The line(s) wired to this PC, e.g. CHOCOLATE  (or ALL, centralized mode only).
POLL_LINES=CHOCOLATE

# Modbus behaviour. The defaults are the values the application already used.
MODBUS_TIMEOUT_SEC=5
# Extra immediate attempts after a failed read (0 = none; the next poll cycle retries).
MODBUS_READ_RETRIES=0
# Waiting time before reconnecting to an unreachable USR; doubles up to the maximum.
MODBUS_BACKOFF_INITIAL_SEC=5
MODBUS_BACKOFF_MAX_SEC=60
# Pause between two polling passes over a USR's gauges.
POLL_CYCLE_PAUSE_SEC=2
# A reading older than this (or a gauge that failed since) is shown as STALE.
STALE_AFTER_SEC=30
# Local port used so that only one app instance per PC polls the gauges.
POLL_LEASE_PORT=47653

# =============================================================================
# EXTRA LOGINS  (in addition to each line's own login below)
# =============================================================================
# One login can be authorised for several lines (it then chooses a line after
# signing in). LINES=ALL means every line. ROLE: operator | admin.
# Only admins may run the "Test connection" check on the Settings page.
USERS=ADMIN
USER_ADMIN_USERNAME=admin
USER_ADMIN_PASSWORD=change-me
USER_ADMIN_LINES=ALL
USER_ADMIN_ROLE=admin

# =============================================================================
# PRODUCTION LINES
# =============================================================================
# Add a line: put its key in LINES and copy a block. Change an IP, password,
# gauge count or limit: edit it here and RESTART the app.
#
# Per line:
#   USERNAME / PASSWORD  this line's own login (sees only this line)
#   GAUGES               number of gauges; gauge number == Modbus slave ID, 1..N
#   GATEWAYS             the line's USR devices: host:port:first-last, ...
#                        USR ids are created from the order: freezer-usr-01, -02 ...
#                        so keep the order stable once data exists.
#   UPPER_LIMIT          pass/fail ceiling in mbar. 0 = NOT SET (every test FAILs)
# Optional:
#   LABEL, DISABLED_USRS (e.g. 3 or freezer-usr-03), DISABLED_GAUGES (e.g. 5,7,10-12),
#   POLL_INTERVAL_SEC (60-3600), READING_DELAY_SEC, MIN_DURATION_SEC, GAP,
#   REGISTER_MAP, SUBNET, PC_IP, ROUTER_IP, COMPANY_PC_IP

LINES=FREEZER,CHOCOLATE,VISI_COOLER,SUS

# ---- Freezer: 54 gauges, 11 USR devices (5 gauges each, the last one 4) ----
LINE_FREEZER_LABEL=Freezer
LINE_FREEZER_USERNAME=freezer
LINE_FREEZER_PASSWORD=freezer@123
LINE_FREEZER_GAUGES=54
LINE_FREEZER_GATEWAYS=192.168.1.3:502:1-5,192.168.1.4:502:6-10,192.168.1.5:502:11-15,192.168.1.6:502:16-20,192.168.1.7:502:21-25,192.168.1.8:502:26-30,192.168.1.9:502:31-35,192.168.1.10:502:36-40,192.168.1.11:502:41-45,192.168.1.12:502:46-50,192.168.1.13:502:51-54
LINE_FREEZER_UPPER_LIMIT=0
LINE_FREEZER_POLL_INTERVAL_SEC=60
LINE_FREEZER_READING_DELAY_SEC=0
LINE_FREEZER_MIN_DURATION_SEC=600
LINE_FREEZER_GAP=0
LINE_FREEZER_REGISTER_MAP=pirani_default
LINE_FREEZER_DISABLED_USRS=
LINE_FREEZER_DISABLED_GAUGES=
# Line-side network (validated at startup: addresses must be inside the subnet,
# must not be the .0 network or .255 broadcast address, and must not clash).
LINE_FREEZER_SUBNET=192.168.1.0/24
LINE_FREEZER_PC_IP=192.168.1.1
LINE_FREEZER_ROUTER_IP=192.168.1.2
LINE_FREEZER_COMPANY_PC_IP=10.100.95.193

